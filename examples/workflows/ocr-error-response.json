{
  "apiVersion": "ai-auto-desktop.dev/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "name": "ocr-error-response",
    "version": "1.0.0",
    "description": "Explicit OCR step followed by a deterministic structured low-confidence error."
  },
  "requires": {
    "runtime": ">=0.1.0",
    "capabilities": [
      {
        "name": "fixture",
        "version": "^1.0.0",
        "actions": [
          "ocr",
          "invoke"
        ]
      }
    ]
  },
  "budgets": {
    "max_duration": "10s",
    "max_executed_steps": 3,
    "cleanup_timeout": "1s"
  },
  "policy": {
    "allowed_risk": {
      "categories": [
        "observe",
        "custom"
      ],
      "max_level": "contextual"
    },
    "untrusted_inputs": {
      "ui_text": "tainted",
      "ocr_text": "tainted",
      "allow_in_control_flow": true
    },
    "screenshots": {
      "retention": "memory_only",
      "cloud_upload": "deny"
    },
    "desktop": {
      "single_writer": true,
      "pause_on_user_input": true,
      "allow_secure_desktop": false
    }
  },
  "steps": [
    {
      "id": "recognize_status",
      "type": "action",
      "uses": "fixture.ocr@1",
      "with": {
        "text": "Retry",
        "language": "en",
        "confidence": 0.41,
        "blocks": []
      },
      "effect": {
        "class": "read_only"
      },
      "risk": {
        "category": "observe",
        "level": "low"
      },
      "timeout": "2s",
      "retry": {
        "max_attempts": 1
      }
    },
    {
      "id": "evaluate_confidence",
      "type": "if",
      "condition": "${{ steps.recognize_status.output.confidence < 0.80 }}",
      "then": [
        {
          "id": "report_low_confidence",
          "type": "fail",
          "error": {
            "code": "OCR.LOW_CONFIDENCE",
            "message": "OCR confidence is below the required threshold",
            "retryable": false,
            "effect": "not_applied",
            "details": {
              "observed_confidence": "${{ steps.recognize_status.output.confidence }}",
              "required_confidence": 0.8,
              "ocr_step": "recognize_status"
            }
          }
        }
      ],
      "else": [
        {
          "id": "click_retry",
          "type": "action",
          "uses": "fixture.invoke@1",
          "with": {
            "operation": "click",
            "target": {
              "role": "button",
              "name": "Retry"
            }
          },
          "effect": {
            "class": "idempotent"
          },
          "risk": {
            "category": "navigate",
            "level": "low"
          },
          "timeout": "2s",
          "retry": {
            "max_attempts": 1
          }
        }
      ]
    }
  ]
}
