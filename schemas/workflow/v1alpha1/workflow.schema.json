          "properties": {
            "type": {
              "const": "fail"
            },
            "error": {
              "$ref": "#/$defs/errorLiteral"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "returnStep": {
      "allOf": [
        {
          "$ref": "#/$defs/stepBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "return"
            },
            "value": {
              "$ref": "#/$defs/valueOrExpression"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 192
    },
    "errorCodePattern": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9_]*\\.)+(?:[A-Z][A-Z0-9_]*|\\*)$",
      "maxLength": 192
    },
    "errorLiteral": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "retryable": {
          "type": "boolean"
        },
        "effect": {
          "enum": [
            "not_applied",
            "applied",
            "unknown"
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "errorHandler": {
      "type": "object",
      "required": [
        "steps",
        "outcome"
      ],
      "properties": {
        "match": {
          "type": "object",
          "properties": {
            "codes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/errorCodePattern"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "effects": {
              "type": "array",
              "items": {
                "enum": [
                  "not_applied",
                  "applied",
                  "unknown"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "as": {
          "$ref": "#/$defs/identifier"
        },
        "steps": {
          "$ref": "#/$defs/nonEmptySteps"
        },
        "outcome": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "rethrow",
                "continue",
                "return"
              ]
            },
            "output": {
              "$ref": "#/$defs/valueOrExpression"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "continue"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "output"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "rethrow"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "output"
                  ]
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*/[A-Za-z][A-Za-z0-9_.-]*$",
        "maxLength": 192
      },
      "additionalProperties": true
    }
  }
}
